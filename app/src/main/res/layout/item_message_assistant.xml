<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="3dp"
    android:paddingEnd="48dp"
    android:paddingBottom="3dp">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_avatar"
        android:contentDescription="@string/app_name"
        android:padding="6dp"
        android:src="@drawable/ic_assistant"
        android:tint="?attr/colorOnPrimaryContainer" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_bubble_assistant"
        android:maxWidth="280dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/assistantMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/assistantItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/assistantMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:alpha="0.6"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
